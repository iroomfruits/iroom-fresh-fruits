# 이 파일을 .env 로 복사해 실제 값을 넣으세요.
NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# 실제 도메인. 끝에 / 없이 입력
PUBLIC_URL=https://www.example.com

# 반드시 변경: 관리자 비밀번호 (10자 이상 권장)
ADMIN_PASSWORD=CHANGE_ME_LONG_PASSWORD

# OpenAI (선택)
OPENAI_API_KEY=

# 주문 메일 알림 (선택)
SMTP_HOST=smtp.naver.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
ORDER_EMAIL=

# Naver Cloud SENS 문자 알림 (선택)
SENS_ACCESS_KEY=
SENS_SECRET_KEY=
SENS_SERVICE_ID=
SENS_FROM=
ADMIN_PHONE=

# 리버스프록시(Caddy/Nginx) 뒤에서 실행할 때
TRUST_PROXY=1
